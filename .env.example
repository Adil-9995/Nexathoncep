# ==============================================================================
# CAMPUSLOOP ENVIRONMENT CONFIGURATION
# Copy this file to .env or .env.local to configure cloud Supabase backend.
# If these variables are omitted, CampusLoop runs in high-fidelity local demo mode
# with browser-session persistence.
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for frontend exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway Sandbox Mode (simulated test environment)
VITE_PAYMENT_SANDBOX_MODE=true

# Platform Commission Rate (Default: 0.02 = 2%)
VITE_PLATFORM_COMMISSION_RATE=0.02
